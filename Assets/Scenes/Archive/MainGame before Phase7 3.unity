  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NullSignal.Story.StoryQuantumRoom
  kind: 5
  index: 5
  encounter: {fileID: 334736707}
  exit: {fileID: 0}
  director: {fileID: 1665247802}
  spawn: {fileID: 1424703308}
  hologram: {fileID: 1998640530}
  candidateVisuals: {fileID: 951544507}
  practicals:
  - {fileID: 2011397372}
  - {fileID: 174351826}
  entranceLines:
  - speaker: ANVESH
    text: Reactor control fragmented. Eight candidate states.
    duration: 3.5
  - speaker: TARA
    text: Track the signal through several search cycles.
    duration: 3.5
  markLines: []
  amplificationLines: []
  successLines:
  - speaker: LUBNA
    text: 'You saw the signal rise, fall, and return.

      More amplification is not always better.'
    duration: 5
  - speaker: TARA
    text: Reactor stabilized. Hold here, Anirudh.
    duration: 3.5
  overshootLines:
  - speaker: ANVESH
    text: Target probability declining.
    duration: 2.5
  - speaker: ANIRUDH
    text: Why? I amplified it again.
    duration: 2.5
  - speaker: LUBNA
    text: Amplitude amplification isn't a charging bar.
    duration: 3.5
  - speaker: LUBNA
    text: 'Go too far and you rotate past

      the state you want.'
    duration: 4
