  - {fileID: 816089933}
  combat: {fileID: 0}
  entranceLines:
  - speaker: ANVESH
    text: Authorization fragmented. Four candidate states.
    duration: 3.5
  - speaker: TARA
    text: Mark the desired signature. Watch what changes.
    duration: 3.5
  markLines:
  - speaker: TARA
    text: You haven't found it.
    duration: 2.5
  - speaker: TARA
    text: 'You''ve only made the desired state

      different from the others.'
    duration: 4
  amplificationLines:
  - speaker: TARA
    text: There. The difference is growing.
    duration: 3
  successLines:
  - speaker: ANIRUDH
    text: So we didn't check all four.
    duration: 2.5
  - speaker: TARA
    text: No.
    duration: 1.4
  - speaker: TARA
    text: We changed the odds.
    duration: 2.5
  overshootLines: []
