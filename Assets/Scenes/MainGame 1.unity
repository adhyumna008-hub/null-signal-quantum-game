  m_EditorClassIdentifier: Assembly-CSharp::NullSignal.Story.StoryQuantumRoom
  kind: 5
  index: 5
  encounter: {fileID: 1718373572}
  exit: {fileID: 1694174529}
  director: {fileID: 976677800}
  spawn: {fileID: 1223809507}
  hologram: {fileID: 2067470791}
  candidateVisuals: {fileID: 386086447}
  practicals:
  - {fileID: 1777789818}
  - {fileID: 322659914}
  combat: {fileID: 0}
  entranceLines:
  - speaker: ANVESH
    text: Reactor control fragmented. Eight candidate states.
    duration: 3.5
  - speaker: TARA
    text: Track the signal through several search cycles.
    duration: 3.5
  markLines: []
  amplificationLines: []
  successLines:
  - speaker: LUBNA
    text: You saw the signal rise, fall, and return. More amplification is not always better.
    duration: 5
  - speaker: TARA
    text: Reactor stable. Security lockdown ahead. Stay ready.
    duration: 3
  overshootLines:
  - speaker: ANVESH
    text: Target probability declining.
    duration: 2.5
  - speaker: ANIRUDH
    text: Why? I amplified it again.
    duration: 2.5
  - speaker: LUBNA
    text: Amplitude amplification isn't a charging bar.
    duration: 3.5
  - speaker: LUBNA
    text: 'Go too far and you rotate past

      the state you want.'
    duration: 4
